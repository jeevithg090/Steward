# Copy to .env.local. Demo only: the bearer token ends up in the browser bundle.
# Passkey approvals (build plan S5.2) replace it.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_TEMPO_TOKEN=

# Showcase mode: 1 runs every page on recorded replay-mode Gateway responses (apps/web/showcase/*.json)
# and never calls a Gateway. This is what the Vercel deployment sets. Any page also switches to the
# showcase for one visit with ?showcase=1 in its URL. Leave unset (or 0) to use the Gateway above.
NEXT_PUBLIC_TEMPO_SHOWCASE=
