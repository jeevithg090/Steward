# Copy to .env.local. Demo only: the bearer token ends up in the browser bundle (passkeys are
# the real auth; Tempo Mesh is not wired into this UI yet). Settings can override all three at
# runtime without a rebuild.
VITE_GATEWAY_URL=http://127.0.0.1:8000
VITE_TEMPO_TOKEN=devtoken
# VITE_TEMPO_SHOWCASE=1     # no Gateway: the app runs on recorded replies (src/showcase/*.json)
