# Copy of .env with no values. Real values go in .env (gitignored), typed by you, never pasted into chat.

# Step 1: ElevenLabs API key (restricted, expiring). SECRET.
ELEVENLABS_API_KEY=

# Step 2: the agent's ID (starts with agent_). Not a password, but keep it out of the page.
ELEVENLABS_AGENT_ID=

# Later: shared secret ElevenLabs sends to our tool proxy (we generate it locally). SECRET.
TEMPO_VOICE_TOOL_SECRET=

# Later: a tempo-hub device token for the tool proxy. SECRET.
TEMPO_HUB_URL=http://127.0.0.1:8787
TEMPO_HUB_DEVICE_TOKEN=

# Public tunnel to the hub (exposes only POST /api/ask and GET /api/hello). Not a secret.
TEMPO_PUBLIC_HUB_URL=
