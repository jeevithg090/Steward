# Copy of .env with no values. Real values go in .env (gitignored, chmod 600), via set_gemini_key.sh, never pasted into chat.

# Gemini API key (Google AI Studio). SECRET. The agents' model: reads the photo, writes the explanation, speaks it.
GEMINI_API_KEY=

# Which Gemini models (defaults shown). gemini-2.5-* are restricted to accounts that used them before; new keys use 3.x.
# TEMPO_AGENTS_MODEL=gemini-3.8-flash
# TEMPO_AGENTS_FAST_MODEL=gemini-3.5-flash-lite
# TEMPO_AGENTS_TTS_MODEL=gemini-3.8-flash-lite-tts
# TEMPO_AGENTS_TTS_VOICE=Kore

# Provider: auto (Gemini when a key is set, else the local model), gemini, or local (Ollama qwen3.5:4b, vision).
# TEMPO_AGENTS_PROVIDER=auto
# TEMPO_AGENTS_LOCAL_MODEL=qwen3.5:4b
# TEMPO_OLLAMA_URL=http://127.0.0.1:11434

# Where to remember what a letter said (the person's own hub on this Mac). Loopback only.
# TEMPO_HUB_URL=http://127.0.0.1:8787
# TEMPO_AGENTS_PORT=8789
