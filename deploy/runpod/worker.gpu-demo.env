# RunPod Serverless vLLM worker for the live GPU demo (plan.md §13, docs/gpu-demo.md).
# One vision-language model serves the three jurors, the chat's small talk and reading photos.
# Paste these into the endpoint's Environment Variables (Quick Deploy → vLLM), or deploy
# deploy/runpod/Dockerfile from GitHub, which bakes the same values in.
# The worker turns any UPPERCASED `vllm serve` flag into that flag (runpod-workers/worker-vllm).
MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
OPENAI_SERVED_MODEL_NAME_OVERRIDE=tempo-private
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.92
MAX_NUM_SEQS=8
# One photo per request, no video; a phone photo becomes at most ~1,280 image tokens.
LIMIT_MM_PER_PROMPT={"image":1,"video":0}
MM_PROCESSOR_KWARGS={"max_pixels":1003520}
# No request logging, no shared prefix cache between people, no telemetry.
DISABLE_LOG_REQUESTS=true
DISABLE_LOG_STATS=true
ENABLE_PREFIX_CACHING=false
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
