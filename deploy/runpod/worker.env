# RunPod Serverless vLLM worker (Private mode). Set these on the endpoint in the RunPod console
# (Secure Cloud, an EU region). (check) every flag against the vLLM worker version you deploy.
MODEL_NAME=Qwen/Qwen3-8B-AWQ
OPENAI_SERVED_MODEL_NAME_OVERRIDE=tempo-private
QUANTIZATION=awq
MAX_MODEL_LEN=16384
ENABLE_AUTO_TOOL_CHOICE=true
TOOL_CALL_PARSER=hermes
# No request logging, no shared prefix cache between people, no telemetry.
DISABLE_LOG_REQUESTS=true
DISABLE_LOG_STATS=true
ENABLE_PREFIX_CACHING=false
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
