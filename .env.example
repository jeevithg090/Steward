# Steward reads this file from the repository root as `.env`.
# Or keep your keys outside the repository and point STEWARD_ENV_FILE at that file.

# ── Model ─────────────────────────────────────────────────────────────────────────
# One provider and its key. `scripted` needs no key: a deterministic model for demos and tests.
STEWARD_MODEL_PROVIDER=openrouter
STEWARD_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# Grok directly through xAI (api.x.ai). Also what "Steward on Grok" in the agent picker needs.
# XAI_API_KEY=
# Ollama on this machine (no key):
# STEWARD_MODEL_PROVIDER=ollama
# STEWARD_MODEL=llama3.2
# Any other OpenAI-compatible server (key optional):
# STEWARD_MODEL_PROVIDER=openai-compatible
# STEWARD_MODEL_BASE_URL=http://127.0.0.1:1234/v1
# STEWARD_MODEL_API_KEY=

# The most one reply may write (default 4096). Lower it if your provider account has little credit.
# STEWARD_MODEL_MAX_TOKENS=4096
# NVIDIA reasoning models run with thinking off (each tool call ~20 s faster). 1 turns it on.
# STEWARD_NVIDIA_THINKING=1

# ── Server ────────────────────────────────────────────────────────────────────────
STEWARD_PORT=8787
# Where the main port binds. Loopback by default; never point a tunnel at it (use the phone port).
# STEWARD_HOST=127.0.0.1
# Extra host names the main port answers, for a VPN you trust. It has no login: see docs/security.md.
# STEWARD_ALLOWED_HOSTS=
STEWARD_DATA_DIR=.steward-data
# Which tenant package under tenants/ to load.
STEWARD_TENANT=steward

# ── Phones ────────────────────────────────────────────────────────────────────────
# The phone port: only /device/*, every call needs a device token. Point a tunnel here, never at
# STEWARD_PORT. "off" switches it off. See docs/phone.md.
# STEWARD_DEVICE_PORT=8788
# The address phones use, until one is set in Settings → Phone.
# STEWARD_DEVICE_URL=https://your-mac.your-tailnet.ts.net
# Bind the phone port beyond loopback, for phones on the same Wi-Fi (plain HTTP; prefer a tunnel).
# STEWARD_DEVICE_HOST=0.0.0.0
# Host names the phone port answers besides loopback, such as your tunnel's, comma separated.
# STEWARD_DEVICE_HOSTS=steward.example.com
# A Cloudflare Access service token in front of the phone port, handed to phones when they pair.
# STEWARD_DEVICE_ACCESS_CLIENT_ID=
# STEWARD_DEVICE_ACCESS_CLIENT_SECRET=
# The phone app's relay (wss://) and the token Steward presents to it. Steward dials out; the
# relay only ever holds ciphertext. Run your own with apps/relay (docs/phone.md).
# STEWARD_RELAY_URL=wss://relay.example.com
# STEWARD_RELAY_TOKEN=

# ── Bots ──────────────────────────────────────────────────────────────────────────
# Where the Bots page reads its directory: an https index.json or a folder's index.json.
# Defaults to directory/index.json in this repository. Run your own with apps/directory.
# STEWARD_DIRECTORY_URL=https://bots.example.com/index.json
# Tell a hosted directory when you install a bot (a count, no identity). Off by default.
# STEWARD_DIRECTORY_COUNTS=1

# ── Agents handing work to agents ─────────────────────────────────────────────────
# How deep delegate_task may go and how many children run at once (defaults 1 and 2).
# STEWARD_DELEGATION_DEPTH=1
# STEWARD_DELEGATION_CONCURRENCY=2

# ── Mail and calendar ─────────────────────────────────────────────────────────────
# The demo inbox and calendar, served by Steward itself. On unless set to 0.
STEWARD_DEMO_GOOGLE=1

# ── The computer ──────────────────────────────────────────────────────────────────
# Show the agent's browser window on this machine instead of running headless.
# STEWARD_HEADFUL=1
# Let the agent's browser reach this machine's own services. Local use only.
# STEWARD_ALLOW_PRIVATE_HOSTS=1
