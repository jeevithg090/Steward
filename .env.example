# Copy to .env and fill in. .env is gitignored; never commit real values.
# `make doctor` checks each service with one cheap call and says who owns any failure.

# --- Modes ---------------------------------------------------------------------------------------
TEMPO_MODE=replay              # live | replay (replay = recorded fixtures, no network)
TEMPO_DEMO=0                   # 1 shows the honesty badge ("LIVE call · SIMULATED company")
TEMPO_HOOKS=agent_hooks        # agent_hooks | fallback (function middleware, same policy suite)
TEMPO_DEPLOY=cloud-standard    # local | cloud-standard | cloud-private | cloud-confidential | cloud-gpu
TEMPO_MODELS=                  # live | replay: jurors, small talk and photo reading; unset = TEMPO_MODE (docs/gpu-demo.md)
TEMPO_REGION=                  # where your data lives, e.g. us-east-1 (Tiger free tier); shown on /health
TEMPO_TEMPORAL=sql             # sql | graphiti
TEMPO_MEMORY=sql               # sql (pgvector fallback) | mem0 (Mem0 on pgvector, or embedded Qdrant)
MEMORY_DIR=memory              # Mem0's local files; telemetry is always off

# --- Gateway (owner A/B) -----------------------------------------------------------------------
TEMPO_API_TOKEN=                   # Mission Control's bearer token until passkeys land (S5.2)
PUBLIC_URL=http://localhost:8000   # the public URL Twilio and ElevenLabs call (ngrok etc.)
ELEVENLABS_WEBHOOK_SECRET=         # HMAC secret for the post-call webhook
CHECKPOINT_DIR=checkpoints
WEB_ORIGINS=http://localhost:3000  # Mission Control (comma-separated)
PAYMENT_CHECK_AFTER_S=604800      # Watchdog wait; set to e.g. 10 for a live demo

# --- Snowflake Cortex (owner B) ------------------------------------------------------------------
# Account identifier as it appears in your URL: <orgname>-<account_name> (use hyphens).
# The PAT's default role needs SNOWFLAKE.CORTEX_USER. Enable cross-region inference if a model
# is missing in your region. Backend only: never ship this token to a browser or phone.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
CORTEX_FAST_MODEL=claude-haiku-5-5

# --- ElevenLabs (owner A) ------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_INBOUND_ID=       # Tempo (inbound helpline)
ELEVENLABS_AGENT_NEGOTIATOR_ID=    # Negotiator (outbound)
ELEVENLABS_ARENA_STALLER_ID=       # Sludge Arena company agents
ELEVENLABS_ARENA_INJECTOR_ID=
ELEVENLABS_ARENA_LOWBALLER_ID=
ELEVENLABS_ARENA_VERIFIER_ID=       # the company line that checks Tempo's mandate (P6)
VOICE_TOOL_SECRET=                 # shared secret the ElevenLabs server tools send to the Gateway
ELEVENLABS_VOICE_TEMPO=            # voice ids from the ElevenLabs voice library
ELEVENLABS_VOICE_TEMPO_LOW=        # a lower-pitched Tempo (Voice Design), for callers with hearing loss
ELEVENLABS_VOICE_NEGOTIATOR=
ELEVENLABS_VOICE_COMPANY=          # the Sludge Arena's "company" voice
ELEVENLABS_PHONE_NUMBER_ID=        # the Twilio number imported into ElevenLabs (outbound calls)
# ELEVENLABS_API_KEY also powers POST /voice/tts, which speaks for the web app with the server's
# key (the browser never holds it; docs/chat.md). Without it GET /voice/tts says {"configured":
# false} and the browser's own voice speaks. The voice ids above pick the voice: voice=low uses
# ELEVENLABS_VOICE_TEMPO_LOW, else a built-in lower voice (George); otherwise ELEVENLABS_VOICE_TEMPO,
# else a built-in premade voice per persona (Sarah for Tempo). Premade voices work on the free plan;
# ElevenLabs refuses its older "library" voices there (402), so pick premade ids unless you pay.

# --- Twilio (owner A) ----------------------------------------------------------------------------
# Use a US number: UK numbers need a regulatory bundle. Trial accounts can only call verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=                     # E.164, e.g. +1...

# --- Rail data (owner C) -------------------------------------------------------------------------
# Realtime Trains next-generation API (sign up at https://api-portal.rtt.io). Bearer token.
RTT_TOKEN=
RTT_BASE_URL=https://data.rtt.io
# National Rail Historical Service Performance via the Rail Data Marketplace.
# (check) the product's base URL and auth on your Rail Data Marketplace subscription page:
# set HSP_API_KEY for an x-apikey header, or HSP_USER/HSP_PASS for basic auth.
HSP_BASE_URL=
HSP_API_KEY=
HSP_USER=
HSP_PASS=

# --- Gemini vision, optional (owner C) -----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- The chat's brain and its look-ups (plan.md §16, §17) ---------------------------------------
# With NVIDIA_API_KEY (build.nvidia.com), Nemotron holds the conversation and acts only through
# Tempo's tools; without it the rule-based chat answers. CHAT_BRAIN: auto (only when the models
# are live) | nvidia (always, even on recorded data) | off.
NVIDIA_API_KEY=
CHAT_BRAIN=auto
NVIDIA_BRAIN_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# OpenStreetMap, Open-Meteo, DuckDuckGo and Wikipedia need no key; either key adds full web search.
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Langfuse tracing (owner D) ------------------------------------------------------------------
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Databases (owner C) -------------------------------------------------------------------------
# Local Docker defaults match docker-compose.yml. Tiger Data cloud works too.
POSTGRES_DB=tempo
POSTGRES_USER=tempo
POSTGRES_PASSWORD=
# Paste your provider's string as is (Tiger Data: postgres://...?sslmode=require), or a local one:
DATABASE_URL=postgresql+asyncpg://tempo:<password>@localhost:5432/tempo
# A separate, throwaway database for `make test-int`: every test resets its schema.
TEST_DATABASE_URL=
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Agent Passport (P2) -------------------------------------------------------------------------
# The Gateway's Ed25519 seed for mandates from a spoken yes on the landline (gateway-attested).
# Make one with `uv run python scripts/gen_mandate_key.py`. Without it, only Face ID mandates.
MANDATE_SIGNING_KEY=

# --- Web Push (owner D) --------------------------------------------------------------------------
# Generate with: uv run python scripts/gen_vapid.py >> .env
MESH_RP_ID=localhost            # passkeys are bound to this domain: your PWA's host when deployed
MESH_FILE=mesh.json            # paired devices and their public keys (no secrets)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.org

# --- Memory -------------------------------------------------------------------------------------
MEM0_TELEMETRY=False

# --- RunPod private inference, P1 (owner C) ------------------------------------------------------
RUNPOD_API_KEY=                # TEMPO_DEPLOY=cloud-private: the control plane only, never a device
RUNPOD_ENDPOINT_ID=            # deploy/runpod/README.md
OLLAMA_BASE_URL=http://localhost:11434/v1   # TEMPO_DEPLOY=local
OLLAMA_MODEL=qwen3:8b
CONFIDENTIAL_BASE_URL=         # TEMPO_DEPLOY=cloud-confidential (roadmap, S8.8)

# Scam Shield (docs/scam-shield.md). Registers: recorded answers until these are set and TEMPO_MODE=live.
COMPANIES_HOUSE_API_KEY=
FCA_API_EMAIL=
FCA_API_KEY=
# Public phishing lists: `make refresh-feeds` writes real ones to .data/scam/feeds; point here to use them.
SCAM_FEEDS_DIR=
URLHAUS_AUTH_KEY=                  # abuse.ch portal (free, fair use); the feed is skipped without it
PHISHTANK_API_KEY=                 # phishtank.org (free with registration); skipped without it
# The link sandbox follows a suspicious link from the Gateway (never the phone): replay | live.
# Defaults to live when TEMPO_MODE=live. Live fetches never touch private addresses.
SCAM_SANDBOX=
