# Copy to .env and fill in. .env is gitignored; never commit real values.
# `make doctor` checks each service with one cheap call and says who owns any failure.

# --- Modes ---------------------------------------------------------------------------------------
TEMPO_MODE=replay              # live | replay (replay = recorded fixtures, no network)
TEMPO_DEMO=0                   # 1 shows the honesty badge ("LIVE call · SIMULATED company")
TEMPO_HOOKS=agent_hooks        # agent_hooks | fallback (function middleware, same policy suite)
TEMPO_DEPLOY=cloud-standard    # local | cloud-standard | cloud-private | cloud-confidential
TEMPO_TEMPORAL=sql             # sql | graphiti

# --- Snowflake Cortex (owner B) ------------------------------------------------------------------
# Account identifier as it appears in your URL: <orgname>-<account_name> (use hyphens).
# The PAT's default role needs SNOWFLAKE.CORTEX_USER. Enable cross-region inference if a model
# is missing in your region. Backend only: never ship this token to a browser or phone.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
CORTEX_FAST_MODEL=claude-haiku-5-5

# --- ElevenLabs (owner A) ------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_INBOUND_ID=       # Tempo (inbound helpline)
ELEVENLABS_AGENT_NEGOTIATOR_ID=    # Negotiator (outbound)
ELEVENLABS_ARENA_STALLER_ID=       # Sludge Arena company agents
ELEVENLABS_ARENA_INJECTOR_ID=
ELEVENLABS_ARENA_LOWBALLER_ID=
VOICE_TOOL_SECRET=                 # shared secret the ElevenLabs server tools send to the Gateway

# --- Twilio (owner A) ----------------------------------------------------------------------------
# Use a US number: UK numbers need a regulatory bundle. Trial accounts can only call verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=                     # E.164, e.g. +1...

# --- Rail data (owner C) -------------------------------------------------------------------------
# Realtime Trains next-generation API (sign up at https://api-portal.rtt.io). Bearer token.
RTT_TOKEN=
RTT_BASE_URL=https://data.rtt.io
# National Rail Historical Service Performance via the Rail Data Marketplace.
# (check) the product's base URL and auth on your Rail Data Marketplace subscription page:
# set HSP_API_KEY for an x-apikey header, or HSP_USER/HSP_PASS for basic auth.
HSP_BASE_URL=
HSP_API_KEY=
HSP_USER=
HSP_PASS=

# --- Gemini vision, optional (owner C) -----------------------------------------------------------
GEMINI_API_KEY=

# --- Langfuse tracing (owner D) ------------------------------------------------------------------
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Databases (owner C) -------------------------------------------------------------------------
# Local Docker defaults match docker-compose.yml. Tiger Data cloud works too.
POSTGRES_DB=tempo
POSTGRES_USER=tempo
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://tempo:<password>@localhost:5432/tempo
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Web Push (owner D) --------------------------------------------------------------------------
# Generate with: uv run python scripts/gen_vapid.py >> .env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.org

# --- Memory -------------------------------------------------------------------------------------
MEM0_TELEMETRY=False

# --- RunPod private inference, P1 (owner C) ------------------------------------------------------
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
